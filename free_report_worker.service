[Unit]
Description=Datazag Free Threat Report Worker (public lead-gen reports)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/datazag_intelligence
# systemd does not set HOME for root services without User= — DuckDB (DuckLake
# extensions/secrets) resolves paths under it and goes offline without it.
Environment=HOME=/root
# DATABASE_URL MUST point at the Customer Portal Neon DB. Also set:
#   INTELLIGENCE_BASE_URL, INTELLIGENCE_API_KEY  (riskscore medallion endpoint)
#   PUBLIC_BASE_URL (https://portal.datazag.com — the /r/<token> viewer lives on
#   the portal; bare datazag.com redirects to www, which 404s on /r/*),
#   RESEND_API_KEY, EMAIL_FROM (must be @notifications.datazag.com, the
#   Resend-verified sending domain)
# Renders the 5-page free single-domain report (freereport); no audience/tier env.
EnvironmentFile=/root/datazag_intelligence/.env
ExecStart=/root/datazag_intelligence/venv/bin/python free_report_worker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
