    {
      "pattern_id": "recovery",
      "title": "Recover expired / unlocked domains",
      "why_html": "Expired registrations and absent locks are live takeover windows \u2014 recover these before any DNS hygiene work.",
      "priority": "now",
      "record_template": "<span class=\"cm\"># at the registrar: renew, then enable</span>\nclientTransferProhibited \u00b7 clientDeleteProhibited \u00b7 clientUpdateProhibited",
      "end_state": null,
      "entries": [
        {
          "domain": "osneycapital.com",
          "segment": "ns:AWS",
          "admin_point": "Amazon Registrar, Inc.",
          "now": "no registrar lock",
          "fix": "renew + set registrar locks"
        }
      ],
      "overflow": 0
    },
    {
      "pattern_id": "dmarc",
      "title": "Enforce DMARC",
      "why_html": "DMARC lets you reject mail spoofed as your domain. Staged: publish <code>p=none</code> with <code>rua</code> first to observe, then move to enforcement.",
      "priority": "now",
      "record_template": "_dmarc.<domain>.  TXT  \"v=DMARC1; p=none; rua=mailto:dmarc@<domain>\"\n<span class=\"cm\"># then, once rua confirms your senders:</span>\n_dmarc.<domain>.  TXT  \"v=DMARC1; p=quarantine; rua=mailto:dmarc@<domain>\"",
      "end_state": "p=reject once rua confirms all senders",
      "entries": [
        {
          "domain": "osneycapital.com",
          "segment": "ns:AWS",
          "admin_point": "AWS",
          "now": "p=none (monitor only)",
          "fix": "p=quarantine"
        },
        {
          "domain": "ploy.io",
          "segment": "ns:AWS",
          "admin_point": "AWS",
          "now": "p=none (monitor only)",
          "fix": "p=quarantine"
