[Unit]
Description=Datazag Scope-My-Estate Worker (WU20 discovery teaser)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/datazag_intelligence
# systemd does not set HOME for root services without User= — DuckDB (DuckLake
# extensions/secrets) resolves paths under it and goes offline without it.
Environment=HOME=/root
# DATABASE_URL MUST point at the Customer Portal Neon DB (same DB as the free
# report worker — it claims from scope_requests). Also set:
#   INTELLIGENCE_BASE_URL, INTELLIGENCE_API_KEY  (riskscore medallion endpoint)
#   PUBLIC_BASE_URL (https://portal.datazag.com — the /scope/result/<token>
#   teaser page lives on the portal),
#   RESEND_API_KEY, EMAIL_FROM (must be @notifications.datazag.com, the
#   Resend-verified sending domain),
#   CORPUS_INDEX_DIR (optional — enables the corpus stem-sweep; absent = cert-SAN only),
#   SCOPE_SLA_SECONDS (optional, default 300)
EnvironmentFile=/root/datazag_intelligence/.env
ExecStart=/root/datazag_intelligence/dzintelligence_env/bin/python scope_worker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
